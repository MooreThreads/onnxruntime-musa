@PACKAGE_INIT@

set(ONNXRUNTIME_MUSA_EP_NAME "MUSAExecutionProvider")
set(ONNXRUNTIME_MUSA_EP_VERSION "@ONNXRUNTIME_MUSA_VERSION@")
set(ONNXRUNTIME_MUSA_ORT_API_VERSION "@ONNXRUNTIME_API_VERSION@")
set(ONNXRUNTIME_MUSA_ORT_BUILD_VERSION "@ONNXRUNTIME_VERSION@")
set_and_check(
  ONNXRUNTIME_MUSA_PLUGIN_PATH
  "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/@MUSA_PLUGIN_INSTALL_FILENAME@"
)
set_and_check(
  ONNXRUNTIME_MUSA_MANIFEST_PATH
  "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_DATADIR@/onnxruntime-ep-musa/@MUSA_EP_MANIFEST_NAME@"
)

check_required_components(onnxruntime_musa_ep)
