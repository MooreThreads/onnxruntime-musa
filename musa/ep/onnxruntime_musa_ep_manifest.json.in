{
  "schema_version": 1,
  "distribution_name": "onnxruntime-ep-musa",
  "ep_name": "MUSAExecutionProvider",
  "plugin_library": "@MUSA_PLUGIN_INSTALL_FILENAME@",
  "plugin_version": "@ONNXRUNTIME_MUSA_VERSION@",
  "ort_api_version": @ONNXRUNTIME_API_VERSION@,
  "ort_build_version": "@ONNXRUNTIME_VERSION@",
  "ort_minimum_version": "@ONNXRUNTIME_VERSION@",
  "ort_tested_versions": ["@ONNXRUNTIME_VERSION@"],
  "platform": "@CMAKE_SYSTEM_NAME@-@CMAKE_SYSTEM_PROCESSOR@",
  "external_runtime_libraries": [
    @MUSA_EXTERNAL_RUNTIME_LIBRARIES@
  ]
}
