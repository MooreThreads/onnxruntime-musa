[build-system]
requires = ["setuptools>=68.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "@package_name@"
version = "@version@"
description = "ONNX Runtime MUSA Plugin Execution Provider"
readme = "onnxruntime_musa/README.md"
license = {text = "Apache-2.0"}
requires-python = ">=3.11"
dependencies = [
  # ABI is pinned to the ORT submodule version (third_party/onnxruntime/VERSION_NUMBER).
  "onnxruntime~=@onnxruntime_version@",
]

[tool.setuptools.packages.find]
include = ["onnxruntime_musa*"]

[tool.setuptools.package-data]
onnxruntime_musa = ["*.dll", "*.so", "*.so.*"]
